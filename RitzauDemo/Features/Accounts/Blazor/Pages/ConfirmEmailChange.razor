@page "/Account/ConfirmEmailChange"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.WebUtilities

@inject AccountOptions AccountOptions
@inject AccountOperations Accounts
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirm email change</PageTitle>

<h1>Confirm email change</h1>
<StatusMessage />
@if (!AccountOptions.EmailEnabled)
{
    <p role="status">This account operation is unavailable.</p>
}
else if (string.IsNullOrEmpty(Input.UserId) || string.IsNullOrEmpty(Input.Email) || string.IsNullOrEmpty(Input.Code))
{
    <p role="alert">Open the full confirmation link from your email.</p>
}
else
{
    <p>Confirm the change to your email address.</p>
    <EditForm Model="Input" FormName="confirm-email-change" OnValidSubmit="ConfirmEnabledEmailChangeAsync" method="post">
        <DataAnnotationsValidator />
        <input type="hidden" name="Input.UserId" value="@Input.UserId" />
        <input type="hidden" name="Input.Email" value="@Input.Email" />
        <input type="hidden" name="Input.Code" value="@Input.Code" />
        <button type="submit" class="account-button-primary">Confirm email change</button>
    </EditForm>
}

@code {

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromForm(FormName = "confirm-email-change")]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        Input ??= new();
        // Account links are read-only on GET; the change happens on the POST below.
        try
        {
            Input.UserId = UserId ?? "";
            Input.Email = Email ?? "";
            Input.Code = Code is null ? "" : Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        }
        catch (FormatException)
        {
            Input.UserId = "";
            Input.Email = "";
            Input.Code = "";
        }
    }

    private async Task ConfirmEnabledEmailChangeAsync()
    {
        var result = await Accounts.ConfirmEmailChangeAsync(new AccountConfirmEmailChangeRequest
        {
            UserId = Input.UserId,
            Email = Input.Email,
            Token = Input.Code
        });
        var response = await AccountPageResultReader.ReadAsync(HttpContext, result);
        var status = response.StatusCode == StatusCodes.Status200OK
            ? "Email changed. Sign in again."
            : "The email change confirmation is invalid, expired or unavailable.";
        RedirectManager.RedirectToWithStatus("Account/ConfirmEmailChange", status, HttpContext);
    }

    private sealed class InputModel
    {
        [Required, StringLength(128)]
        public string UserId { get; set; } = "";

        [Required, EmailAddress, StringLength(254)]
        public string Email { get; set; } = "";

        [Required, StringLength(4096)]
        public string Code { get; set; } = "";
    }
}
