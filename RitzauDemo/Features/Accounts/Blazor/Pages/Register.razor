@page "/Account/Register"

@using System.ComponentModel.DataAnnotations

@inject IdentityRedirectManager RedirectManager
@inject AccountOptions AccountOptions
@inject AccountOperations Accounts

<PageTitle>Register</PageTitle>

<h1>Register</h1>

<StatusMessage Message="@Message" />
@if (AccountOptions.RegistrationEnabled)
{
    <div class="account-grid">
        <div class="account-grid-main">
            <EditForm Model="EmailInput" method="post" OnValidSubmit="RegisterEnabledUser" FormName="register-enabled">
                <DataAnnotationsValidator />
                <h2>Create a new account.</h2>
                <hr class="account-divider" />
                <ValidationSummary class="account-text-danger" role="alert" />
                <div class="account-field">
                    <InputText @bind-Value="EmailInput.Email" id="EmailInput.Email" class="account-input" autocomplete="email" maxlength="254" aria-required="true" placeholder="name@example.com" />
                    <label for="EmailInput.Email">Email</label>
                    <ValidationMessage For="() => EmailInput.Email" class="account-text-danger" />
                </div>
                <p class="account-muted">We’ll send a confirmation link. Choose your password after confirming your email.</p>
                <button type="submit" class="account-button-primary account-button-full">Request registration</button>
            </EditForm>
        </div>
    </div>
}
else
{
    <p class="account-alert account-alert-info" role="status">Registration is unavailable.</p>
}

@code {
    private string? message;

    [SupplyParameterFromForm(FormName = "register-enabled")]
    private EmailInputModel EmailInput { get; set; } = default!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? Message => message;

    protected override void OnInitialized()
    {
        EmailInput ??= new();
    }

    private async Task RegisterEnabledUser()
    {
        var result = await Accounts.RegisterAsync(new AccountRegisterRequest { Email = EmailInput.Email });
        var response = await AccountPageResultReader.ReadAsync(HttpContext, result);
        if (response.StatusCode == StatusCodes.Status202Accepted)
        {
            RedirectManager.RedirectTo("Account/RegisterConfirmation", new() { ["email"] = EmailInput.Email });
            return;
        }

        message = AccountPageResultReader.Message(response.Body, "Unable to process the request. Try again later.");
    }

    private sealed class EmailInputModel
    {
        [Required, EmailAddress, StringLength(254)]
        public string Email { get; set; } = "";
    }
}
