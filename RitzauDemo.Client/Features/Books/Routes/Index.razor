@page "/"
@page "/books"

<PageTitle>Books</PageTitle>

<main class="mx-auto max-w-6xl space-y-6">
    <header class="rounded-xl border border-gray-200 bg-white px-5 py-6 shadow-sm sm:px-7">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">Books</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">Browse the public sample catalog or manage books saved to your account.</p>
        <div class="mt-4">
            <RenderModeBadge Assigned="@AssignedRenderMode" ConfiguredMode="Interactive Auto" />
        </div>
    </header>

    <AuthorBookcase />

    <AuthorizeView>
        <Authorized>
            <UserBookcase />
        </Authorized>
        <NotAuthorized>
            <UserBookcaseLoginPrompt />
        </NotAuthorized>
        <Authorizing>
            <p class="rounded-lg bg-gray-50 px-4 py-5 text-sm text-gray-600" role="status">Checking your account...</p>
        </Authorizing>
    </AuthorizeView>
</main>
