@page "/books/new"
@attribute [Authorize(Roles = AccountRoleNames.Admin)]
@implements IDisposable

@inject IBooksApi Books
@inject UserBookcaseState UserBooks
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Nav
@inject ILogger<BookCreate> Logger

<PageTitle>Add a book</PageTitle>

<main class="mx-auto max-w-2xl" data-testid="book-create-page">
    <a class="text-sm font-semibold text-blue-700 underline underline-offset-2 hover:text-blue-900 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600" href="/books">← Back to your books</a>
    <section class="mt-5 rounded-lg border border-gray-200 bg-white p-5 shadow-sm sm:p-8">
        <h1 class="text-2xl font-bold text-gray-900">Add a book</h1>
        <p class="mt-2 text-sm text-gray-600">Add a book to your private list.</p>
        <div class="mt-6">
            <BookForm Model="_model" SubmitLabel="Save book" CancelHref="/books" Error="@_error" IsBusy="_saving" OnValidSubmit="SaveAsync" />
        </div>
    </section>
</main>

@code {
    private readonly BookFormModel _model = new();
    private readonly CancellationTokenSource _operationCancellation = new();
    private bool _saving;
    private string? _error;

    private async Task SaveAsync(BookFormModel model)
    {
        if (_saving) return;
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userId = GetUserKey(authenticationState.User);
        if (!authenticationState.User.IsInRole(AccountRoleNames.Admin) || string.IsNullOrWhiteSpace(userId))
        {
            _error = "Administrator access is required to add a book.";
            return;
        }

        _saving = true;
        _error = null;
        try
        {
            var created = await Books.CreateAsync(new CreateBookRequest
            {
                Title = model.Title.Trim(),
                Author = NormalizeOptional(model.Author),
                Url = NormalizeOptional(model.Url)
            }, _operationCancellation.Token);

            var latestAuthenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            if (!string.Equals(userId, GetUserKey(latestAuthenticationState.User), StringComparison.Ordinal) ||
                !latestAuthenticationState.User.IsInRole(AccountRoleNames.Admin))
            {
                return;
            }

            UserBooks.ApplySavedBook(new BookListItemResponse
            {
                Id = created.Id,
                Title = created.Title,
                Author = created.Author,
                Url = created.Url
            });
            await UserBooks.LoadForCurrentUserAsync(_operationCancellation.Token);
            Nav.NavigateTo($"/books/{created.Id}");
        }
        catch (OperationCanceledException) when (_operationCancellation.IsCancellationRequested)
        {
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Book creation failed.");
            _error = "The book could not be saved. Your entries are still here; please try again.";
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? NormalizeOptional(string? value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string? GetUserKey(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.NameIdentifier)?.Value ??
        user.FindFirst(ClaimTypes.Name)?.Value ??
        user.Identity?.Name;

    public void Dispose()
    {
        _operationCancellation.Cancel();
        _operationCancellation.Dispose();
    }
}
