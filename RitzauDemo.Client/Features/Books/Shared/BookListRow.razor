<article class="flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center sm:justify-between"
         data-testid="@($"book-row-{Id}")">
    <div class="min-w-0">
        <h3 class="break-words text-base font-semibold text-gray-900">
            <a class="rounded-sm underline decoration-gray-300 underline-offset-4 hover:text-blue-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
               data-testid="@($"book-details-{Id}")"
               href="@DetailsHref">@Title</a>
        </h3>
        <p class="mt-1 break-words text-sm text-gray-600">@(string.IsNullOrWhiteSpace(Author) ? "Author not listed" : Author)</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2">
        <a class="inline-flex min-h-10 items-center justify-center rounded-md border border-gray-300 bg-white px-3.5 py-2 text-sm font-semibold text-gray-800 no-underline hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
           href="@DetailsHref">Details</a>
        @if (EditHref is not null)
        {
            <AuthorizeView Roles="@AccountRoleNames.Admin">
                <Authorized>
                    <a class="inline-flex min-h-10 items-center justify-center rounded-md bg-gray-900 px-3.5 py-2 text-sm font-semibold text-white no-underline hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                       data-testid="@($"book-edit-{Id}")"
                       href="@EditHref">Edit</a>
                </Authorized>
            </AuthorizeView>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired]
    public int Id { get; set; }

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Author { get; set; }

    [Parameter, EditorRequired]
    public string DetailsHref { get; set; } = string.Empty;

    [Parameter]
    public string? EditHref { get; set; }
}
