<Project>
  <Target Name="ValidateFrontendProfile" BeforeTargets="Restore;PrepareForBuild;Build;Publish;Pack;VSTest">
    <Error
      Condition="'$(FrontendProfileFromEnvironment)' != ''"
      Text="The FrontendProfile environment variable is not supported. Use the supported BlazorAuto profile or an explicit -p:FrontendProfile validation override." />
    <Error
      Condition="'$(FrontendProfile)' == ''"
      Text="The frontend profile is missing or empty. The supported profile is BlazorAuto." />
    <Error
      Condition="'$(FrontendProfile)' != '' and $([System.String]::CompareOrdinal('$(FrontendProfile)', 'BlazorAuto')) != 0"
      Text="Invalid frontend profile. Expected exactly BlazorAuto." />
  </Target>
</Project>
