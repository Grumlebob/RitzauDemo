############################################
# Local Docker environment for RitzauDemo
#
# Copy this file to .env and keep .env uncommitted. Start the local stack with
# Scripts/LocalDevelopment/RunLocal.ps1; it supplies only Compose interpolation inputs and leaves
# the raw account values for the web container's format: raw env_file.
############################################

App__Name=ritzaudemo
App__Url=https://localhost:28186
APP_NODE_NAME=local-web

# Host-side ports used by docker-compose.yml. Change these when your
# machine already has one of the defaults in use.
APP_HTTPS_HOST_PORT=28186
POSTGRES_HOST_PORT=25433
REDIS_HOST_PORT=26380
REDIS_INSIGHT_HOST_PORT=25540
GRAFANA_HOST_PORT=23000
ALERTMANAGER_HOST_PORT=29093
PROMETHEUS_HOST_PORT=29090
LOKI_HOST_PORT=23100
TEMPO_HOST_PORT=23200
ALLOY_HOST_PORT=22345
POSTGRES_EXPORTER_HOST_PORT=29187
REDIS_EXPORTER_HOST_PORT=29121

# PostgreSQL container and app database connection.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

Database__Host=postgres
Database__Port=5432
Database__Name=app
Database__Username=postgres
Database__Password=postgres

# Redis.
Redis__Configuration=redis:6379

# OpenTelemetry is off by default; RunLocal.ps1 -Observability turns it on.
# docker-compose.yml maps these to the app's Observability__OpenTelemetry__* settings.
OBSERVABILITY_ENABLED=false
OBSERVABILITY_OTLP_ENDPOINT=http://alloy:4317
OBSERVABILITY_OTLP_PROTOCOL=Grpc
OBSERVABILITY_TRACE_SAMPLE_RATIO=1.0
OBSERVABILITY_DEPLOYMENT_TARGET=local

# Local setup fills these with generated values; seeding creates each account once and never resets it.
# Account values are read as raw KEY=value strings. Leave them unquoted; spaces,
# $, #, quotes and additional = characters are preserved. Newlines are unsupported.
Accounts__AdminSeed__Enabled=false
Accounts__AdminSeed__Email=
Accounts__AdminSeed__Password=
Accounts__UserSeed__Enabled=false
Accounts__UserSeed__Email=
Accounts__UserSeed__Password=
